{
  "name": "Quizzes and results",
  "item": [
    {
      "name": "Create quiz as owner",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Select the owner's token; quiz creation requires group membership.",
              "pm.collectionVariables.set('accessToken', pm.collectionVariables.get('ownerToken'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Verify quiz creation and save its identity for submission and results checks.",
              "pm.test('owner creates quiz', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('quiz is associated with its group and creator', () => {",
              "  pm.expect(body.quiz.group_id).to.eql(pm.collectionVariables.get('groupId'));",
              "  pm.expect(body.quiz.creator_id).to.eql(pm.collectionVariables.get('ownerId'));",
              "});",
              "// Submission and result requests target this newly created quiz.",
              "pm.collectionVariables.set('quizId', body.quiz.id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Create a one-question quiz in the saved group using the owner token. Expect HTTP 201 and the saved group and owner IDs in the response; save the quiz ID for submission and results.",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Postman test quiz\",\"category\":\"Integration\",\"group_id\":\"{{groupId}}\",\"questions\":[{\"question\":\"2 + 2?\",\"options\":[\"3\",\"4\"],\"correctAnswer\":\"4\"}]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/quizzes"
      },
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{ownerToken}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "Member cannot update owner's quiz",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Group membership alone does not permit editing another user's quiz.",
              "pm.test('non-creator cannot update quiz', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "description": "Attempt to update the owner's quiz using the joined member's token. Expect HTTP 403 because only the creator may edit it.",
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Unauthorized change\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/quizzes/{{quizId}}",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Quiz submission rejects missing answers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Invalid submissions must not create an attempt.",
              "pm.test('missing answers are rejected', () => pm.response.to.have.status(400));",
              "pm.test('response identifies missing answers', () => pm.expect(pm.response.json().message).to.eql('Answers array is required'));"
            ]
          }
        }
      ],
      "request": {
        "description": "Submit a quiz without an answers array using the member token. Expect HTTP 400; the later results check should still contain only the valid attempt.",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/quizzes/{{quizId}}/submit",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{memberToken}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "Member submits quiz",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Switch inherited authentication from the owner to the joined member.",
              "pm.collectionVariables.set('accessToken', pm.collectionVariables.get('memberToken'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Confirm the answer was scored correctly and the result belongs to the member.",
              "pm.test('member submits quiz', () => pm.response.to.have.status(201));",
              "const result = pm.response.json().result;",
              "pm.test('server scores answers and assigns the authenticated member', () => {",
              "  // The request supplies the correct answer to the quiz's only question.",
              "  pm.expect(result.score).to.eql(1);",
              "  pm.expect(result.total_questions).to.eql(1);",
              "  pm.expect(result.user_id).to.eql(pm.collectionVariables.get('memberId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Switch the collection's current accessToken to the member token and submit the correct answer to the saved quiz. Expect HTTP 201, a score of 1 out of 1, and the member ID on the result.",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"answers\":[\"4\"]}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/quizzes/{{quizId}}/submit"
      }
    },
    {
      "name": "Member reads own quiz results",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Verify the personal-results view contains the attempt just submitted.",
              "pm.test('member can read personal results', () => pm.response.to.have.status(200));",
              "const results = pm.response.json().results;",
              "pm.test('personal view includes the submitted result', () => {",
              "  // This scenario submits one attempt before requesting the personal view.",
              "  pm.expect(results).to.have.lengthOf(1);",
              "  pm.expect(results[0].score).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "description": "Request the saved quiz's personal-results view with the member token after submitting one attempt. Expect HTTP 200 and one result with a score of 1.",
        "method": "GET",
        "url": "{{baseUrl}}/quizzes/{{quizId}}/results?view=mine"
      },
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{memberToken}}",
            "type": "string"
          }
        ]
      }
    }
  ]
}
