{
  "name": "Owner authentication",
  "item": [
    {
      "name": "Register owner",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generate unique owner and member identities for this isolated test run.",
              "// Later registration and login requests reuse these collection variables.",
              "const stamp = Date.now().toString();",
              "pm.collectionVariables.set('ownerUsername', `pm_owner_${stamp}`);",
              "pm.collectionVariables.set('ownerEmail', `pm_owner_${stamp}@example.test`);",
              "pm.collectionVariables.set('ownerAuthId', `postman-owner-${stamp}`);",
              "pm.collectionVariables.set('memberUsername', `pm_member_${stamp}`);",
              "pm.collectionVariables.set('memberEmail', `pm_member_${stamp}@example.test`);",
              "pm.collectionVariables.set('memberAuthId', `postman-member-${stamp}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Verify registration succeeds, does not expose a password, and save the owner ID.",
              "pm.test('owner is registered', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('registration returns safe profile fields', () => {",
              "  pm.expect(body.user.username).to.eql(pm.collectionVariables.get('ownerUsername'));",
              "  pm.expect(body.user).not.to.have.property('password');",
              "});",
              "// Group and quiz tests use this ID to verify ownership and attribution.",
              "pm.collectionVariables.set('ownerId', body.user.user_id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Generate unique owner and member identities for this run, then register the owner without authentication. Expect HTTP 201 and a profile without a password; save the owner ID for later ownership checks.",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"auth_id\":\"{{ownerAuthId}}\",\"firstname\":\"Postman\",\"surname\":\"Owner\",\"username\":\"{{ownerUsername}}\",\"email\":\"{{ownerEmail}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/register"
      },
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "Login owner",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Store the owner's token for later owner-authorized requests.",
              "pm.test('owner login succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "// accessToken supplies the collection-level bearer authentication.",
              "pm.collectionVariables.set('ownerToken', body.token);",
              "pm.collectionVariables.set('accessToken', body.token);",
              "pm.test('login returns a bearer token', () => pm.expect(body.token).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "description": "Log in with the generated owner credentials without prior authentication. Expect HTTP 200 and a non-empty token; save it both as ownerToken and as the collection's current accessToken for group creation.",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"user\":\"{{ownerUsername}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/login"
      },
      "auth": {
        "type": "noauth"
      }
    }
  ]
}
