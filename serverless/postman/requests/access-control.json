{
  "name": "Membership and access control",
  "item": [
    {
      "name": "Member leaves group",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Confirm a member can leave the group.",
              "pm.test('member can leave the group', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "description": "Remove the member's own group membership.",
        "method": "DELETE",
        "url": "{{baseUrl}}/groups/{{groupId}}/members/leave"
      },
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{memberToken}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "Former member cannot list group quizzes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Verify a former member immediately loses access to this group's quizzes.",
              "pm.test('former member is forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "description": "Check access is denied after the member has left the group.",
        "method": "GET",
        "url": "{{baseUrl}}/quizzes?group_id={{groupId}}"
      },
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{memberToken}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "Protected route rejects missing token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Remove the collection token so this protected request exercises unauthenticated access.",
              "pm.collectionVariables.set('accessToken', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// The protected endpoint must reject requests without a bearer token.",
              "pm.test('missing token is unauthorized', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "description": "Verify protected endpoints reject requests with no token.",
        "method": "GET",
        "url": "{{baseUrl}}/groups",
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}
