{
  "name": "Member authentication",
  "item": [
    {
      "name": "Register member",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Verify the member profile is safe to return and save its ID.",
              "pm.test('member is registered', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('member registration does not expose password', () => pm.expect(body.user).not.to.have.property('password'));",
              "// The login and quiz-result checks compare their user ID with this value.",
              "pm.collectionVariables.set('memberId', body.user.user_id);"
            ]
          }
        }
      ],
      "request": {
        "description": "Register the member identity generated during owner registration without authentication. Expect HTTP 201 and no password in the profile; save the member ID for login and quiz-result checks.",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"auth_id\":\"{{memberAuthId}}\",\"firstname\":\"Postman\",\"surname\":\"Member\",\"username\":\"{{memberUsername}}\",\"email\":\"{{memberEmail}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/register"
      },
      "auth": {
        "type": "noauth"
      }
    },
    {
      "name": "Login rejects incorrect password",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Incorrect credentials must not issue an application token.",
              "pm.test('incorrect password is rejected', () => pm.response.to.have.status(401));",
              "pm.test('failed login does not return a token', () => pm.expect(pm.response.json()).not.to.have.property('token'));"
            ]
          }
        }
      ],
      "request": {
        "description": "Attempt to log in as the registered member with an incorrect password. Expect HTTP 401 and no token.",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"user\":\"{{memberUsername}}\",\"password\":\"{{password}}-wrong\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/login",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Login member",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Verify login returns the registered member and retain the member JWT.",
              "pm.test('member login succeeds', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('member login returns the registered profile', () => pm.expect(body.user.user_id).to.eql(pm.collectionVariables.get('memberId')));",
              "// Preserve the member token and use it for subsequent inherited authentication.",
              "pm.collectionVariables.set('memberToken', body.token);",
              "pm.collectionVariables.set('accessToken', body.token);"
            ]
          }
        }
      ],
      "request": {
        "description": "Log in with the generated member credentials without prior authentication. Expect HTTP 200 and the previously registered member ID; save the token and select it as the collection's current accessToken for joining the group.",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"user\":\"{{memberUsername}}\",\"password\":\"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/login"
      },
      "auth": {
        "type": "noauth"
      }
    }
  ]
}
