PORT=5000

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres_password_123@postgres:5432/quiz_devsecops
POSTGRES_DB=quiz_devsecops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123
