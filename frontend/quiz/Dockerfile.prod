FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json package-lock.json ./

RUN npm ci

#COPY . .
COPY src ./src
COPY public ./public
COPY index.html vite.config.ts playwright.config.ts ./
COPY tsconfig*.json ./

# Vite embeds these at build time
ARG VITE_API_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_API_URL=$VITE_API_URL \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

RUN npm run build

FROM nginx:1.31.7-alpine3.24

# nginx-module-xslt (och libxslt) behövs inte för statiska filer och har öppna CVE:er
RUN apk del --no-cache nginx-module-xslt && \
    apk add --no-cache libcap && \
    # Ge Nginx-binären rättighet att binda till låga portar (<1024)
    setcap 'cap_net_bind_service=+ep' /usr/sbin/nginx && \
    # Ändra ägandeskap på mappar som Nginx skriver till under körning
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx /var/run/

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

USER nginx

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]