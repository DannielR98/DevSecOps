# syntax=docker/dockerfile:1
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json package-lock.json ./

RUN npm ci

#COPY . .
COPY src ./src
COPY public ./public
COPY index.html vite.config.ts playwright.config.ts ./
COPY tsconfig*.json ./

FROM build AS frontend-bundle

# These values are public in the generated browser bundle.
ARG VITE_API_URL
ARG VITE_SUPABASE_URL

# The mounted anon/publishable key is also embedded in the browser bundle.
RUN --mount=type=secret,id=supabase_anon_key,env=VITE_SUPABASE_ANON_KEY,required=true \
    test -n "$VITE_SUPABASE_ANON_KEY" && npm run build

FROM nginx:1.31.7-alpine3.24

# nginx-module-xslt (och libxslt) behövs inte för statiska filer och har öppna CVE:er
RUN apk del --no-cache nginx-module-xslt && \
    apk add --no-cache libcap \
      libxml2=2.13.9-r3 \
      alpine-release=3.24.4-r0 \
      brotli-libs=1.2.1-r0 \
      curl=8.23.0-r0 \
      libcurl=8.23.0-r0 \
      libexpat=2.10.0-r0 \
      libxml2=2.13.9-r3 \
      libx11=1.8.14-r0 \
      musl=1.2.6-r3 \
      musl-utils=1.2.6-r3 \
      zlib=1.4-r0 && \
    # Ge Nginx-binären rättighet att binda till låga portar (<1024)
    setcap 'cap_net_bind_service=+ep' /usr/sbin/nginx && \
    # Ändra ägandeskap på mappar som Nginx skriver till under körning
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx /var/run/

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend-bundle /app/build /usr/share/nginx/html

EXPOSE 80

USER nginx

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]