{
  "name": "quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "echo \"No tests yet\"",
    "bdd:gen": "bddgen",
    "test:ui": "npm run bdd:gen && playwright test --project=ui",
    "test:ui-mode": "npm run bdd:gen && playwright test --project=ui --ui",
    "test:headed": "npm run bdd:gen && playwright test --project=ui --headed",
    "test:debug": "npm run bdd:gen && playwright test --project=ui --debug",
    "test:pwdebug": "npm run bdd:gen && PWDEBUG=1 playwright test --project=ui",
    "test:pwdebug:win": "npm run bdd:gen && cross-env PWDEBUG=1 playwright test --project=ui",
    "test:codegen": "playwright codegen",
    "report": "playwright show-report"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.24.1",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-jss": "^10.10.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "react-toastify": "^11.1.0",
    "redux-saga": "^1.5.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "playwright-bdd": "^9.2.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}