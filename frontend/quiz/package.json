{
  "name": "quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "bdd:gen": "bddgen",
    "test:ui": "npm run bdd:gen && playwright test --project=ui",
    "test:ui-mode": "npm run bdd:gen && playwright test --project=ui --ui",
    "test:headed": "npm run bdd:gen && playwright test --project=ui --headed",
    "test:debug": "npm run bdd:gen && playwright test --project=ui --debug",
    "test:pwdebug": "npm run bdd:gen && PWDEBUG=1 playwright test --project=ui",
    "test:pwdebug:win": "npm run bdd:gen && cross-env PWDEBUG=1 playwright test --project=ui",
    "test:codegen": "playwright codegen",
    "report": "playwright show-report"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.15.0",
    "@supabase/supabase-js": "^2.119.2",
    "axios": "^1.21.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-jss": "^10.10.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.6",
    "react-toastify": "^11.2.0",
    "redux-saga": "^1.6.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright-bdd": "^9.2.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
